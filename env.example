# Copiar a .env y completar. Los valores de acá son los mismos que usa
# config.py por defecto, salvo la clave de API.

# --- Roboflow ---
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_WORKSPACE=pinv011159
# Proyecto del split corregido. El original (macroinvertebrados-acuaticos)
# reparte las ráfagas del mismo espécimen entre train y test: ver
# docs/leakage_analysis.md antes de usarlo.
ROBOFLOW_PROJECT=macroinvertebrados-split-limpio-kuhq3

# --- Modelo ---
MODEL_NAME=yolo11s.pt
EXPERIMENT_NAME=macros
# 200 épocas con parada temprana (paciencia 30); los tres checkpoints
# versionados pararon entre la 156 y la 200.
TRAINING_EPOCHS=200
IMG_SIZE=640
# Con 6 GB de VRAM, batch=16 es el techo para modelos "s" a 640 px
# (yolo12s necesitó bajar a 8). Subirlo requiere más memoria.
BATCH_SIZE=16
WORKERS=8
SEED=42
# Regularización por atención: penaliza la activación fuera de la caja.
# 0.0 = desactivada. Ver models/attention_regularization.py.
ATTENTION_REG_LAMBDA=0.0

# --- Inferencia ---
# Punto de operación, seleccionado sobre validación. No usar para calcular
# mAP: para eso el protocolo estándar es conf=0.001 (ver MAP_EVAL_CONF en
# models/trainer.py).
CONFIDENCE_THRESHOLD=0.3
IOU_THRESHOLD=0.6

# --- Logging ---
LOG_LEVEL=INFO

# --- Índice BMWP ---
# Calcula el índice biótico a partir de las familias detectadas.
# El índice se define por SITIO de muestreo: usar predict_batch() sobre todas
# las fotos del sitio, no una imagen suelta.
ENABLE_BMWP=True
